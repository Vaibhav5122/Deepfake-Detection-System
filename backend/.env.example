# MongoDB connection string (local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/deepsight

# Secret key used to sign JWT tokens (replace with a strong random hex string)
JWT_SECRET=change_this_to_a_strong_random_secret_key

# Comma-separated list of allowed CORS origins (leave empty to allow all origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional API key required in the X-API-Key header for /api/detect/* routes (leave empty to disable in local dev)
API_KEY=
